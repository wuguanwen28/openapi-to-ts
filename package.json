{
  "name": "wgw-openapi-to-ts",
  "version": "0.0.4",
  "description": "将 OpenAPI 文档转换为 TypeScript 类型和接口方法",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "bin": {
    "openapi": "./bin/index.js"
  },
  "scripts": {
    "dev": "rollup -c rollup.config.ts --configPlugin typescript -w",
    "build": "rollup -c rollup.config.ts --configPlugin typescript",
    "test": "node ./test/test.js"
  },
  "keywords": [
    "openapi",
    "ts",
    "typescript",
    "generator"
  ],
  "author": "wuguanwen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wuguanwen28/openapi-to-ts"
  },
  "packageManager": "pnpm@10.17.0",
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "chalk": "^4.1.2",
    "cosmiconfig": "^9.0.0",
    "node-fetch": "^3.3.2",
    "number-to-words": "^1.2.4",
    "nunjucks": "^3.2.4",
    "prettier": "^3.7.4",
    "prompts": "^2.4.2",
    "recast": "^0.23.11",
    "reserved-words": "^0.1.2",
    "swagger2openapi": "^7.0.8",
    "tiny-pinyin": "^1.3.2"
  },
  "devDependencies": {
    "@babel/types": "^7.28.5",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^14.18.63",
    "@types/nunjucks": "^3.2.6",
    "@types/reserved-words": "^0.1.4",
    "@types/swagger2openapi": "^7.0.4",
    "openapi3-ts": "^2.0.2",
    "rollup": "^4.54.0",
    "rollup-plugin-dts": "^6.3.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
